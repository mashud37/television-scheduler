SMTP_HOST: "smtp.gmail.com"
SMTP_PORT: "587"
SMTP_USER: "your.address@gmail.com"
SMTP_PASS: "the16characterapppassword"
EMAIL_TO: "where-you-want-the-tv-emails@example.com"

BASE_URL: "https://YOUR-SERVICE-URL.a.run.app"

SECRET_KEY: "change-me-generate-a-random-value"
ACCESS_TOKEN: "change-me-generate-a-random-value"
JOB_TOKEN: "change-me-generate-a-random-value"

# GCS volume mount paths (set up a Cloud Storage bucket mounted at /mnt/data)
DB_PATH: "/mnt/data/tv_scheduler.db"
MODEL_PATH: "/mnt/data/models/tv_component_models.joblib"
RANKER_PREFS_PATH: "/mnt/data/ranker_prefs.yaml"

HTTPS: "true"

# Used only to build a Cloud Logging link in the failure email.
GCP_PROJECT: "your-gcp-project-id"

# The scheduler fires daily; a full run happens only once CYCLE_DAYS have passed
# since the last successful one, so a failed cycle retries the next morning.
CYCLE_DAYS: "7"
# Days of schedule to collect. The ARD API serves at most 8.
COLLECT_DAYS: "8"

# Public constant taken from the ZDF web player. Override only if it stops working.
ZDF_API_KEY: ""
